# Independent project/volumes. Same image and code, different country/region/source.
# Public, disposable LOCAL demonstration credentials; replace for a shared deployment.
COMPOSE_PROJECT_NAME=iris-second-host
COUNTRY_CODE=ZM
REGION_CODE=LSK
SOURCE_ENDPOINT=file:///fixtures/zm-lsk.json
FIXTURE_PATH=./fixtures
OUTPUT_PATH=/output/second-host
DB_NAME=iris_second_host
