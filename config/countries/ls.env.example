# Lesotho synthetic pilot; DEMO is a test region, not an administrative code.
# Public, disposable LOCAL demonstration credentials; never use on a shared deployment.
COMPOSE_PROJECT_NAME=iris-ls
COUNTRY_CODE=LS
REGION_CODE=DEMO
SOURCE_ENDPOINT=file:///fixtures/ls-demo.json
FIXTURE_PATH=./fixtures
OUTPUT_PATH=/output/ls
DB_NAME=iris_ls
DB_ADMIN_USER=iris_admin
DB_ADMIN_PASSWORD=local-demo-admin-only
APP_DB_USER=iris_worker
APP_DB_PASSWORD=local-demo-worker-only
